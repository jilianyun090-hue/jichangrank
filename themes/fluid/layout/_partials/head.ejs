<%
var separator = theme.title_join_string || theme.tab_title_separator
var title = page.title ? [page.title, config.author || 'ClashVPNs'].join(separator) : config.title

// 为归档页面生成唯一的标题以消除重复标题警告
if (page.archive) {
  var archiveTitle = '文章归档'
  if (page.year) {
    archiveTitle = page.year + '年' + (page.month ? page.month + '月' : '') + '归档'
  }
  title = [archiveTitle, config.author || 'ClashVPNs'].join(separator)
}

if (page && page.current && page.current > 1) {
  title = title + ' - 第' + page.current + '页'
}
var keywords = page.keywords || config.keywords
if (keywords instanceof Array) {
  keywords = keywords.join(',')
}
var description = page.description || page.excerpt || (is_post() && page.content) || config.description
// If this is a list/category/index page without an explicit description, build a clearer fallback
if (!page.description && !page.excerpt && page.title && !is_post()) {
  description = (page.title || '') + ' — ' + (config.description || '')
}
if (description) {
  description = strip_html(description).substring(0, 160).trim().replace(/\n/g, ' ')
}
var ogImage = page.og_img || page.index_img
var ogConfig = Object.assign({
  title: title,
  description: description,
  image: ogImage && url_for(ogImage)
}, theme.open_graph)

// 动态控制搜索引擎收录，避免索引同质化的归档页、标签页和翻页列表
var robotsContent = 'index, follow'
if (is_archive() || is_tag() || (page && page.current && page.current > 1)) {
  robotsContent = 'noindex, follow'
}
%>

<head>
  <meta charset="UTF-8">

  <link rel="apple-touch-icon" sizes="76x76" href="<%= url_for(theme.apple_touch_icon) %>">
  <link rel="icon" href="<%= url_for(theme.favicon) %>">
  <% if (theme.canonical.enable) { %>
    <link rel="canonical" href="<%= url_join(config.url, page.canonical_path.replace('index.html', '')) %>"/>
  <% } %>

  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, shrink-to-fit=no">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <% if (theme.force_https) { %>
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
  <% } %>
  <meta name="theme-color" content="<%= theme.color.navbar_bg_color %>">
  <meta name="author" content="<%= page.author || config.author %>">
  <meta name="keywords" content="<%= keywords %>">
  <% if (theme.open_graph.enable) { %>
    <%- open_graph(ogConfig) %>
  <% } else { %>
    <meta name="description" content="<%= description %>">
  <% } %>
  <% if ((theme.post.meta.views.enable && theme.post.meta.views.source === 'busuanzi')
    || (theme.footer.statistics.enable && theme.footer.statistics.source === 'busuanzi')) { %>
    <meta name="referrer" content="no-referrer-when-downgrade">
  <% } %>
  <% if (theme.custom_head) { %>
    <%- theme.custom_head %>
  <% } %>

  <meta name="language" content="zh-CN" />
  <meta name="revisit-after" content="3 days" />
  <meta name="robots" content="<%= robotsContent %>" />

  <% if (is_post()) { %>
  <!-- Article JSON-LD Schema -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": page.title || "",
    "description": description || "",
    "url": url_join(config.url, page.path),
    "datePublished": page.date ? (typeof page.date.toISOString === 'function' ? page.date.toISOString() : page.date) : "",
    "dateModified": page.updated ? (typeof page.updated.toISOString === 'function' ? page.updated.toISOString() : page.updated) : (page.date ? (typeof page.date.toISOString === 'function' ? page.date.toISOString() : page.date) : ""),
    "author": {
      "@type": "Person",
      "name": page.author || config.author || "ClashVPNs"
    },
    "publisher": {
      "@type": "Organization",
      "name": config.author || "ClashVPNs",
      "url": config.url
    },
    "inLanguage": "zh-CN",
    "keywords": keywords || ""
  }, null, 2) %>
  </script>
  <% } else { %>
  <!-- WebSite JSON-LD Schema -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": config.author || "ClashVPNs",
    "url": config.url,
    "description": description || "",
    "inLanguage": "zh-CN",
    "potentialAction": {
      "@type": "SearchAction",
      "target": config.url + "/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }, null, 2) %>
  </script>
  <% } %>

  <title><%= title %></title>

  <%- partial('_partials/css.ejs') %>
  <%- export_config() %>
  <%- js_ex(theme.static_prefix.internal_js, 'utils.js') %>
  <%- js_ex(theme.static_prefix.internal_js, 'color-schema.js') %>
  <%- partial('_partials/plugins/analytics.ejs') %>

  <%- inject_point('head') %>
</head>
